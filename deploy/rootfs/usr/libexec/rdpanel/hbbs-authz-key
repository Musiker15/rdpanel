#!/bin/sh
# Usage: hbbs-authz-key <file>
#
# Makes sure <file> holds the secret hbbs presents to the panel's connection
# authorization endpoint (AUTHZ_SECRET_FILE / RDPANEL_HBBS_AUTHZ_SECRET_FILE):
# 32 random bytes as lowercase hex and a newline, the format rdpanel writes
# itself when it starts first. A non-empty file is left alone. A new one is
# written with mode 0600 by put-file, which never writes through a symlink and
# renames into place, so readers never see half a secret. Prints "exists" or
# "generated".
set -eu
f=${1:?usage: hbbs-authz-key <file>}
if [ -s "$f" ]; then
	echo exists
	exit 0
fi
secret=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
printf '%s\n' "$secret" | grep -qxE '[0-9a-f]{64}' || { echo "hbbs-authz-key: could not generate a secret" >&2; exit 1; }
printf '%s\n' "$secret" | "$(dirname "$0")/put-file" "$f" 0600
echo generated
